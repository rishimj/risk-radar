# Copy to .env before `make demo`.  Nothing here is required for news ingestion —
# every feed is free and keyless.  The only value you must change is SECRET_KEY.

# ---- webapp ----
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# ---- AWS / DynamoDB ----
# Locally these are dummies; dynamodb-local ignores credentials but boto3 demands
# that they exist.  On EC2, DELETE DYNAMO_ENDPOINT_URL entirely and drop the keys —
# boto3 will use the instance role.  That single unset is the only local↔prod diff.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---- ingestion ----
FETCH_INTERVAL_SECONDS=120
MAX_ARTICLE_AGE_HOURS=6
ENABLE_GNEWS=true
# SEC EDGAR 8-K feed needs a contact address in the User-Agent per SEC policy,
# and CIK→ticker mapping.  Off by default.
ENABLE_SEC=false
SEC_CONTACT_EMAIL=

# ---- sentiment ----
# Falls back FinBERT -> FinVADER -> VADER automatically if torch is unavailable.
SENTIMENT_MODEL=ProsusAI/finbert

# ---- risk / alerting ----
# Alerting is relative to each ticker's own trailing 24h baseline, not a fixed
# threshold.  See the Calibration section of the plan for why a constant fails.
ALERT_PERCENTILE=99
MIN_MENTIONS_FOR_ALERT=2
MIN_BASELINE_SAMPLES=50
ALERT_COOLDOWN_MINUTES=10
WINDOW_SIZE_SECONDS=900
WINDOW_SLIDE_SECONDS=180
WATERMARK_DELAY_SECONDS=30
