# /srv/risk-radar/risk-radar.env  (owner riskradar, chmod 600)
# install.sh creates this on first deploy with a freshly generated SECRET_KEY.
# There are NO API keys in this app: every news feed is free and keyless.

SECRET_KEY=__generated_by_install__
COOKIE_SECURE=true
LOG_LEVEL=INFO

# single-node backends
REDIS_URL=unix:///srv/risk-radar/run/redis.sock?db=0
DB_BACKEND=sqlite
SQLITE_PATH=/srv/risk-radar/data/riskradar.db
BUS=inproc

# pipeline
FETCH_INTERVAL_SECONDS=120
MAX_ARTICLE_AGE_HOURS=6
ENABLE_GNEWS=true
ENABLE_SEC=false
ALERT_PERCENTILE=99
ALERT_COOLDOWN_MINUTES=10

# public-demo guards (see services/webapp/src/guard.py for the full list)
GUEST_DEMO=true
GUEST_MAX_AGE_HOURS=48
RL_ACCOUNTS_PER_DAY=300
SIMULATE_GLOBAL_SECONDS=240
ENABLE_API_DOCS=false
