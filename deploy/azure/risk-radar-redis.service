# Private Redis for RiskRadar: unix socket only (no TCP port at all), owned by
# the riskradar user, capped at 64 MB of data. Independent of any system Redis.
[Unit]
Description=Redis for RiskRadar (unix socket only)
After=network.target

[Service]
Type=simple
User=riskradar
Group=riskradar
WorkingDirectory=/srv/risk-radar
ExecStart=/usr/bin/redis-server /srv/risk-radar/redis.conf
Restart=always
RestartSec=3

MemoryMax=128M
TasksMax=16

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/risk-radar/redis /srv/risk-radar/run
PrivateTmp=true
ProtectHome=true
PrivateDevices=true
PrivateNetwork=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
